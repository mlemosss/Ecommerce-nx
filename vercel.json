{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "sh \"$(git rev-parse --show-toplevel)/scripts/vercel-build.sh\"",
  "outputDirectory": "apps/storefront/.next",
  "rewrites": [
    { "source": "/admin", "destination": "https://ecommerce-nx-admin-marcolemosjr-hotmailcoms-projects.vercel.app/admin" },
    { "source": "/admin/:path*", "destination": "https://ecommerce-nx-admin-marcolemosjr-hotmailcoms-projects.vercel.app/admin/:path*" }
  ]
}
