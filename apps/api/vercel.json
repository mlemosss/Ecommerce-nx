{
  "framework": null,
  "installCommand": "sh \"$(git rev-parse --show-toplevel)/scripts/vercel-install.sh\"",
  "buildCommand": "sh \"$(git rev-parse --show-toplevel)/scripts/vercel-migrate.sh\" && npx nx run api:build-serverless",
  "outputDirectory": "dist-serverless",
  "rewrites": [{ "source": "/:path*", "destination": "/api" }],
  "crons": [{ "path": "/api/email-flow/run-scheduled", "schedule": "*/30 * * * *" }]
}
