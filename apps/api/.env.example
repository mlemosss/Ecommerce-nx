DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Integração com Meta Commerce Catalog (opcional)
META_ACCESS_TOKEN=""
META_CATALOG_ID=""
META_APP_ID=""
META_APP_SECRET=""

# URL pública da loja virtual, usada no campo "link" dos itens do catálogo
STOREFRONT_URL="http://localhost:3000"

# Integração de pagamento com a Asaas
# ASAAS_ENV: "sandbox" (padrão, ambiente de testes) ou "production"
# ASAAS_API_KEY: chave de API da conta Asaas (Configurações > Integrações > API)
# ASAAS_WEBHOOK_TOKEN: token definido ao criar o Webhook na Asaas (header asaas-access-token),
#   usado para validar que a notificação realmente veio de lá
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
