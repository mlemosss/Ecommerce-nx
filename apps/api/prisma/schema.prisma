generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  category        String
  description     String            @default("")
  costPrice       Float
  price           Float
  compareAtPrice  Float?
  images          String            @default("[]")
  // Só o hash e a extensão de cada foto, para montar a URL sem arrastar a
  // foto inteira para fora do banco.
  //
  // As fotos moram em `images` como dataURL em base64, e o hash que vai na
  // URL é calculado sobre a dataURL inteira. Resultado: toda leitura do
  // catálogo puxava ~3,7 MB de Postgres só para montar dez strings. Em 18
  // dias isso queimou os 5 GB de transferência do plano e suspendeu o banco.
  //
  // NULL quer dizer "ainda não calculado" — diferente de "[]", que é produto
  // sem foto nenhuma. A diferença importa: sem ela, produto sem foto voltaria
  // a ser lido por inteiro em toda visita.
  imageMeta       String?
  active          Boolean           @default(true)
  shopeeItemId    BigInt?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  variants        ProductVariant[]
  favorites       Favorite[]
  reviews         ProductReview[]
  stockAlerts     StockAlert[]

  @@map("products")
}

// "Avise-me quando chegar": alguém quis uma cor/tamanho que estava sem estoque.
//
// Guarda cor e tamanho como texto, e não o id da variação, de propósito — a
// combinação pedida pode nem existir ainda no cadastro, e é justamente essa a
// informação mais valiosa para decidir reposição.
//
// O e-mail é coletado para uma finalidade única e declarada: avisar sobre esta
// peça. Depois de avisado, o registro cumpriu o propósito e pode ser apagado —
// não vira lista de marketing.
//
// (Comentário de linha, não de bloco: o Prisma não aceita /* */ e o schema
// inteiro deixa de validar — foi o que derrubou dois deploys seguidos.)
model StockAlert {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String
  size       String
  email      String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  // Pedir de novo a mesma peça não cria uma segunda linha nem um segundo
  // e-mail: o upsert reaproveita e devolve o registro ao estado "esperando".
  @@unique([productId, color, size, email])
  @@index([productId, notifiedAt])
  @@map("stock_alerts")
}

model ShopeeIntegration {
  id                String    @id @default("singleton")
  shopId            BigInt?
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt DateTime?
  defaultCategoryId Int?
  updatedAt         DateTime  @updatedAt

  @@map("shopee_integration")
}

model ProductReview {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String
  customerName String
  rating       Int
  comment      String
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  // Foto de quem usou a peça, opcional. É o formato de prova social que mais
  // converte em moda: a cliente quer ver a roupa num corpo parecido com o dela,
  // não em foto de estúdio. Guardada como dataURL, igual à foto de produto.
  photoUrl     String?
  // Pedido de onde veio a avaliação, quando ela chegou pelo link.
  //
  // Serve para duas coisas: impedir a mesma pessoa de avaliar o mesmo produto
  // duas vezes pelo mesmo pedido, e marcar no painel quais avaliações vieram de
  // compra confirmada — que valem mais do que as outras.
  orderId      String?

  @@unique([orderId, productId])
  @@map("product_reviews")
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@map("favorites")
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String
  size       String
  stock      Int         @default(0)
  price      Float?
  costPrice  Float?
  saleItems  SaleItem[]

  @@unique([productId, color, size])
  @@map("product_variants")
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  personType     String   @default("PF")
  documentNumber String?
  birthDate      DateTime?
  phone          String?
  email          String?  @unique
  passwordHash   String?
  // Reivindicação de conta criada pelo checkout: quem compra sem se cadastrar
  // vira um Customer sem senha. Definir senha nesse registro exige confirmar o
  // e-mail, senão qualquer um que soubesse o endereço tomaria a conta.
  passwordSetToken          String?   @unique
  passwordSetTokenExpiresAt DateTime?
  description    String?
  tags           String   @default("")
  zipCode        String?
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sales          Sale[]
  orders         Order[]
  favorites      Favorite[]

  @@map("customers")
}

model Sale {
  id            String     @id @default(cuid())
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  paymentMethod String
  status        String     @default("concluida")
  installments  Int        @default(1)
  total         Float
  createdAt     DateTime   @default(now())
  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id               String         @id @default(cuid())
  saleId           String
  sale             Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  unitPrice        Float

  @@map("sale_items")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  category    String
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())

  @@map("expenses")
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String
  discountValue  Float
  minOrderValue  Float?
  usageLimit     Int?
  // Quantas vezes o MESMO CPF pode usar. Diferente de `usageLimit`, que e o
  // total da loja: um cupom de 10% sem esta trava e desconto permanente para
  // quem descobrir o codigo, e o codigo esta impresso em toda pagina.
  //
  // Tambem diferente de `firstPurchaseOnly`, que so vale para quem nunca
  // comprou. Aqui quem ja e cliente usa - uma vez, ou quantas o numero disser.
  usageLimitPerDocument Int?
  usageCount     Int       @default(0)
  // Cupom de estreia: vale uma vez por CPF. A checagem é pelo documento, não
  // pelo e-mail nem pela conta — criar e-mail novo custa segundos, e o cupom
  // de primeira compra viraria desconto permanente para quem descobrisse.
  firstPurchaseOnly Boolean @default(false)
  active         Boolean   @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("coupons")
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  customerDocument  String
  zipCode           String
  city              String
  // Bairro e UF nao existiam, e sem eles nao se posta encomenda: a etiqueta
  // dos Correios exige os dois. Dava para deduzir pelo CEP, ate a cliente
  // morar em cidade de CEP unico - ai o bairro so existe se ela tiver escrito.
  neighborhood      String?
  state             String?
  street            String
  number            String
  complement        String?
  subtotal          Float
  shipping          Float
  discount          Float       @default(0)
  couponCode        String?
  total             Float
  // Retirada em maos, em vez de envio. Guardado no pedido porque muda o que
  // a lojista faz com ele: nao posta, combina a entrega. Sem isso ela so
  // descobriria pelo frete zerado, que tambem acontece em compra acima do
  // minimo de frete gratis.
  pickup            Boolean     @default(false)
  // Servico de frete que a cliente escolheu e pagou (id do Melhor Envio).
  // Guardado para a etiqueta sair pela mesma transportadora que ela pagou -
  // comprar outra faz a loja bancar a diferenca sem perceber.
  shippingServiceId String?
  // Nome legivel da transportadora, do jeito que a cliente viu no checkout.
  // O id sozinho nao diz onde postar o pacote - e essa e a pergunta que a
  // lojista faz depois de imprimir a etiqueta.
  shippingServiceName String?
  // Envio criado no Melhor Envio. Gravado ANTES da compra da etiqueta: se a
  // resposta se perder no caminho, a proxima tentativa reaproveita este id em
  // vez de criar um segundo envio e pagar duas vezes.
  shipmentId        String?
  // PDF da etiqueta, depois de comprada.
  shipmentLabelUrl  String?
  paymentMethod     String
  status            String      @default("aguardando_pagamento")
  // Identificadores de clique da Meta, copiados dos cookies no checkout.
  //
  // Ficam no pedido porque o Purchase da API de Conversoes sai depois - as
  // vezes minutos depois, quando o webhook do Pix confirma - e ai nao ha mais
  // requisicao do navegador por perto para ler cookie nenhum. Sem eles, a
  // venda chega a Meta sem ligacao com o anuncio que a trouxe.
  metaFbp           String?
  metaFbc           String?
  asaasCustomerId   String?
  asaasPaymentId    String?
  asaasInvoiceUrl   String?
  shippedAt           DateTime?
  trackingCode        String?
  reviewRequestSentAt DateTime?
  // Token do link de avaliação: noexcusenx.com.br/avaliar/<token>.
  //
  // A loja é de compra sem cadastro, então quem comprou não tem senha — e o
  // e-mail de avaliação levava a uma tela de login que o cliente não conseguia
  // passar. O token identifica o pedido sem exigir conta, e serve só para ele.
  //
  // Não expira de propósito: expirar deixaria a lojista sem poder recuperar uma
  // avaliação atrasada, e o estrago máximo de um token vazado é uma avaliação
  // falsa num pedido que de fato existiu.
  reviewToken         String?   @unique
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  size        String
  color       String
  quantity    Int
  unitPrice   Float

  @@map("order_items")
}

model StoreSettings {
  id                     String   @id @default("singleton")
  storeName              String   @default("NO EXCUSE")
  contactEmail           String?
  contactWhatsapp        String?
  shippingFee            Float    @default(19.9)
  freeShippingThreshold  Float    @default(199.9)
  pixEnabled             Boolean  @default(true)
  cardEnabled            Boolean  @default(true)
  boletoEnabled          Boolean  @default(true)
  maxInstallments        Int      @default(3)
  instagramUrl           String?
  facebookUrl            String?
  heroTag                String   @default("Nova coleção")
  heroTitleLine1         String   @default("Treine sem")
  heroTitleHighlight     String   @default("limites.")
  heroSubtitle           String   @default("Roupas de academia pensadas para quem treina de verdade: compressão certa, respirabilidade e caimento que acompanham cada repetição.")
  heroPrimaryButtonLabel String   @default("Ver produtos")
  heroSecondaryButtonLabel String @default("Explorar leggings")
  newsletterTitle        String   @default("Ganhe 10% na primeira compra")
  newsletterSubtitle     String   @default("Cadastre seu e-mail e receba um cupom exclusivo, além de novidades de lançamentos.")
  valueProps             String   @default("[{\"title\":\"Troca grátis em 30 dias\",\"description\":\"Não serviu ou não gostou? Trocamos sem burocracia.\"},{\"title\":\"Entrega para todo o Brasil\",\"description\":\"Envio rastreado com prazos exibidos no checkout.\"},{\"title\":\"Tecido testado em treino real\",\"description\":\"Compressão, respirabilidade e durabilidade validadas por atletas.\"},{\"title\":\"Pagamento seguro\",\"description\":\"Pix, cartão em até 3x sem juros ou boleto.\"}]")
  // Tabela de medidas, em JSON: [{ category, size, bust, waist, hip }].
  // Alimenta a tabela e o provador na página de produto.
  sizeGuide              String   @default("[]")
  // Google Ads: ID da tag (AW-...) e rótulo da ação de conversão de compra.
  googleAdsId            String?
  googleAdsConversionLabel String?
  // Desconto progressivo, em JSON: [{ minItems, percent }]. Vazio = desligado.
  progressiveDiscount    String   @default("[]")
  // Cupom oferecido no e-mail de boleto vencido, para a pessoa voltar. Vazio =
  // o e-mail sai só como aviso de cancelamento. O código não é validado aqui:
  // criar o cupom em Cupons é passo separado, e anunciar código inexistente
  // faz o cliente digitar e levar "cupom inválido" bem na hora que voltou.
  winbackCouponCode      String?
  winbackCouponPercent   Int      @default(0)
  // Cupom do e-mail de agradecimento de quem pediu aviso de reposição.
  // Separado do winback porque são momentos diferentes: um é para quem gerou
  // boleto e não pagou, outro para quem nem chegou a montar carrinho.
  stockAlertCouponCode    String?
  stockAlertCouponPercent Int     @default(0)
  // Faixa de promoção no topo. Sem texto, não aparece; passada a data, some sozinha.
  promoBannerText        String?
  promoBannerEndsAt      DateTime?
  // Página "Quem somos". Texto livre, editável pelo painel.
  aboutHeadline          String?
  aboutBody              String?
  // Frete: origem e embalagem padrão usadas na cotação do Melhor Envio.
  // Vazio aqui = cai na env MELHOR_ENVIO_FROM_CEP e, por último, no padrão do código.
  shippingOriginZip      String?
  // Endereco completo do remetente. O CEP sozinho cota o frete, mas nao emite
  // etiqueta: os Correios querem rua, numero, bairro, cidade e UF de quem
  // posta. Vazio = o botao de gerar etiqueta avisa e nao tenta.
  shippingOriginStreet   String?
  shippingOriginNumber   String?
  shippingOriginComplement String?
  shippingOriginDistrict String?
  shippingOriginCity     String?
  shippingOriginState    String?
  packageHeightCm        Int      @default(10)
  packageWidthCm         Int      @default(16)
  packageLengthCm        Int      @default(20)
  // Identificacao da empresa, exigida pelo CDC no rodape de loja virtual.
  // Ficam vazios ate a lojista preencher: mostrar um CNPJ de exemplo e pior
  // do que nao mostrar nenhum.
  legalName              String?
  cnpj                   String?
  // Microsoft Clarity: mapa de cliques e gravacao de sessao. Carrega junto
  // com o resto da medicao, so depois do aceite de cookies.
  clarityProjectId       String?
  gtmId                  String?
  metaPixelId             String?
  emailFromName          String   @default("NO EXCUSE")
  emailFromAddress       String   @default("onboarding@resend.dev")
  updatedAt              DateTime @updatedAt

  @@map("store_settings")
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  // E-mail de quem avaliou. Nunca aparece no site: existe para a loja poder
  // agradecer, ou procurar quem nao gostou antes que a nota vire reclamacao
  // publica. Por isso a listagem publica seleciona campos um a um.
  email        String?
  photoUrl     String?
  quote        String
  rating       Int      @default(5)
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model EmailFlowStep {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("email_flow_steps")
}

model AbandonedCart {
  id         String    @id @default(cuid())
  email      String    @unique
  // Consentimento explícito para receber o lembrete. Sem `true` aqui, nada é
  // enviado: e-mail de recuperação é marketing, e marketing exige opt-in.
  optIn      Boolean   @default(false)
  name       String?
  // Telefone, para a lojista chamar no WhatsApp. Guardado sob o mesmo
  // consentimento do e-mail: a caixa do checkout fala dos dois.
  phone      String?
  itemsJson  String
  total      Float
  recovered  Boolean   @default(false)
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("abandoned_carts")
}

model CustomPayment {
  id          String   @id @default(cuid())
  description String
  method      String   @default("pix")
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("custom_payments")
}

model Quote {
  id           String      @id @default(cuid())
  customerName String?
  status       String      @default("aberto")
  notes        String?
  total        Float
  items        QuoteItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("quotes")
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float

  @@map("quote_items")
}
