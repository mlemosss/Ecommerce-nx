generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  category        String
  description     String            @default("")
  costPrice       Float
  price           Float
  compareAtPrice  Float?
  images          String            @default("[]")
  active          Boolean           @default(true)
  shopeeItemId    BigInt?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  variants        ProductVariant[]
  favorites       Favorite[]
  reviews         ProductReview[]

  @@map("products")
}

model ShopeeIntegration {
  id                String    @id @default("singleton")
  shopId            BigInt?
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt DateTime?
  defaultCategoryId Int?
  updatedAt         DateTime  @updatedAt

  @@map("shopee_integration")
}

model ProductReview {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String
  customerName String
  rating       Int
  comment      String
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("product_reviews")
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@map("favorites")
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String
  size       String
  stock      Int         @default(0)
  price      Float?
  costPrice  Float?
  saleItems  SaleItem[]

  @@unique([productId, color, size])
  @@map("product_variants")
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  personType     String   @default("PF")
  documentNumber String?
  birthDate      DateTime?
  phone          String?
  email          String?  @unique
  passwordHash   String?
  // Reivindicação de conta criada pelo checkout: quem compra sem se cadastrar
  // vira um Customer sem senha. Definir senha nesse registro exige confirmar o
  // e-mail, senão qualquer um que soubesse o endereço tomaria a conta.
  passwordSetToken          String?   @unique
  passwordSetTokenExpiresAt DateTime?
  description    String?
  tags           String   @default("")
  zipCode        String?
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sales          Sale[]
  orders         Order[]
  favorites      Favorite[]

  @@map("customers")
}

model Sale {
  id            String     @id @default(cuid())
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  paymentMethod String
  status        String     @default("concluida")
  installments  Int        @default(1)
  total         Float
  createdAt     DateTime   @default(now())
  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id               String         @id @default(cuid())
  saleId           String
  sale             Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  unitPrice        Float

  @@map("sale_items")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  category    String
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())

  @@map("expenses")
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String
  discountValue  Float
  minOrderValue  Float?
  usageLimit     Int?
  usageCount     Int       @default(0)
  active         Boolean   @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("coupons")
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  customerDocument  String
  zipCode           String
  city              String
  street            String
  number            String
  complement        String?
  subtotal          Float
  shipping          Float
  discount          Float       @default(0)
  couponCode        String?
  total             Float
  paymentMethod     String
  status            String      @default("aguardando_pagamento")
  asaasCustomerId   String?
  asaasPaymentId    String?
  asaasInvoiceUrl   String?
  shippedAt           DateTime?
  trackingCode        String?
  reviewRequestSentAt DateTime?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  size        String
  color       String
  quantity    Int
  unitPrice   Float

  @@map("order_items")
}

model StoreSettings {
  id                     String   @id @default("singleton")
  storeName              String   @default("No Excuse")
  contactEmail           String?
  contactWhatsapp        String?
  shippingFee            Float    @default(19.9)
  freeShippingThreshold  Float    @default(199.9)
  pixEnabled             Boolean  @default(true)
  cardEnabled            Boolean  @default(true)
  boletoEnabled          Boolean  @default(true)
  maxInstallments        Int      @default(3)
  instagramUrl           String?
  facebookUrl            String?
  heroTag                String   @default("Nova coleção")
  heroTitleLine1         String   @default("Treine sem")
  heroTitleHighlight     String   @default("limites.")
  heroSubtitle           String   @default("Roupas de academia pensadas para quem treina de verdade: compressão certa, respirabilidade e caimento que acompanham cada repetição.")
  heroPrimaryButtonLabel String   @default("Ver produtos")
  heroSecondaryButtonLabel String @default("Explorar leggings")
  newsletterTitle        String   @default("Ganhe 10% na primeira compra")
  newsletterSubtitle     String   @default("Cadastre seu e-mail e receba um cupom exclusivo, além de novidades de lançamentos.")
  valueProps             String   @default("[{\"title\":\"Troca grátis em 30 dias\",\"description\":\"Não serviu ou não gostou? Trocamos sem burocracia.\"},{\"title\":\"Entrega para todo o Brasil\",\"description\":\"Envio rastreado com prazos exibidos no checkout.\"},{\"title\":\"Tecido testado em treino real\",\"description\":\"Compressão, respirabilidade e durabilidade validadas por atletas.\"},{\"title\":\"Pagamento seguro\",\"description\":\"Pix, cartão em até 3x sem juros ou boleto.\"}]")
  // Página "Quem somos". Texto livre, editável pelo painel.
  aboutHeadline          String?
  aboutBody              String?
  // Frete: origem e embalagem padrão usadas na cotação do Melhor Envio.
  // Vazio aqui = cai na env MELHOR_ENVIO_FROM_CEP e, por último, no padrão do código.
  shippingOriginZip      String?
  packageHeightCm        Int      @default(10)
  packageWidthCm         Int      @default(16)
  packageLengthCm        Int      @default(20)
  gtmId                  String?
  metaPixelId             String?
  emailFromName          String   @default("NO EXCUSE")
  emailFromAddress       String   @default("onboarding@resend.dev")
  updatedAt              DateTime @updatedAt

  @@map("store_settings")
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  photoUrl     String?
  quote        String
  rating       Int      @default(5)
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model EmailFlowStep {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("email_flow_steps")
}

model AbandonedCart {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  itemsJson  String
  total      Float
  recovered  Boolean   @default(false)
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("abandoned_carts")
}

model CustomPayment {
  id          String   @id @default(cuid())
  description String
  method      String   @default("pix")
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("custom_payments")
}

model Quote {
  id           String      @id @default(cuid())
  customerName String?
  status       String      @default("aberto")
  notes        String?
  total        Float
  items        QuoteItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("quotes")
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float

  @@map("quote_items")
}
